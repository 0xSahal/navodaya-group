# Copy to .env.local and fill in. Never commit .env.local.

# Sanity — public, safe to expose to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server + scripts only (seeding, migrations). Editor permissions.
# Never prefix with NEXT_PUBLIC.
SANITY_API_WRITE_TOKEN=

# Shared secret for the Sanity publish webhook.
SANITY_REVALIDATE_SECRET=

# Optional Google Search Console HTML-tag verification content.
# Leave blank until you have a token from Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Resend (form submissions) -------------------------------------------
# API key from resend.com/api-keys
RESEND_API_KEY=

# Where studio notifications land. Until a domain is verified in Resend, this
# MUST be the email address that owns the Resend account, or delivery fails.
CONTACT_EMAIL=

# Verified-domain sender, e.g. "Navodaya <studio@navodayagroup.com>".
# Leave blank until the domain is verified in Resend. While blank the studio
# still gets notified, but the enquirer gets no acknowledgement.
RESEND_FROM=

# --- MongoDB (form submission persistence) -------------------------------
# Atlas connection string. Include the password; do not commit the real value.
# Example: mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# Documents land in the "navodaya" database, "leads" collection.
MONGODB_URI=
